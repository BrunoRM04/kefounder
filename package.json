{
  "name": "kefounder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch-path=server --watch-path=shared server/index.js",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/api.test.js tests/admin.test.js",
    "test:e2e": "node --disable-warning=ExperimentalWarning tests/e2e.mjs",
    "admin": "node --disable-warning=ExperimentalWarning server/admin-cli.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.63.0",
    "vite": "^6.0.5"
  }
}
